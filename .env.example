# Copy to .env and fill in.

# Google Shopping Egypt via SerpAPI (https://serpapi.com) — free tier = 100 searches/month.
# Leave empty to use only the direct store scrapers.
SERPAPI_KEY=

# Facebook Marketplace city slug for the deep link (cairo, alexandria, giza, tanta ...)
FB_CITY=cairo

PORT=8080
CACHE_TTL_SECONDS=900
SOURCE_TIMEOUT_SECONDS=25
MAX_RESULTS_PER_SOURCE=20
# 0..1 — share of query words a title must contain. Lower = more results, more noise.
MIN_RELEVANCE=0.6
ENABLE_PLAYWRIGHT=true
# Optional outbound proxy for scrapers (residential/Egyptian IP helps if a store blocks you)
SCRAPER_PROXY=
